# Supabase — copy from your project's API settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used by Netlify Functions (set in Netlify dashboard, not committed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Sign-in redirects. The live address is https://ranked-voting.hintwise.org
# (https://ranked-voting.netlify.app answers 301 to it, netlify.toml). Google
# sign-in and the emailed link return to the page they started on
# (window.location.origin), so the Supabase project's Authentication > URL
# Configuration needs:
#   Site URL:      https://ranked-voting.hintwise.org
#   Redirect URLs: https://ranked-voting.hintwise.org/**
#                  http://localhost:5173/**   (local development)
