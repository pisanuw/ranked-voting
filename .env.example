# The shared HintWise Supabase project (claude-built-apps platform/supabase.json). Both values
# are public by design: they are shipped in the browser bundle. On Netlify they come from
# netlify.toml [build.environment]; for a local build, copy this file to .env.
# Never put a service-role key here or anywhere in this app: nothing uses one.
VITE_SUPABASE_URL=https://auth.hintwise.org
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFya3R4bHJseWNlZmZ5b3pkd2hxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY4ODEwMTAsImV4cCI6MjA5MjQ1NzAxMH0.Vuku-irT3kAHZYibK23q6dpyOEqV_Eg5zB78I3dyshE

# The Netlify functions need no variables: they carry the same two public values in
# netlify/functions/_lib/supabase.js and act as the caller (anon key, plus the signed-in
# person's own token).
#
# Sign-in (Google, or a 6-digit code by email through the platform's sign-in-link function)
# returns only to https://*.hintwise.org pages, which the shared project's auth allow list
# already covers: nothing to set per app. It does not return to localhost.
